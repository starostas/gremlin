# Gateway deployment (a separate Vercel project rooted at services/gpu-gateway).
# Connect a private Vercel Blob store and enable the gremlin-gpu-jobs Queue topic.
# Every variable here is server-only: none of it reaches the browser.
QUEUE_REGION=iad1
MAX_PENDING_JOBS=6

# Comma-separated docs origins allowed to start runs. Without a match the job
# routes refuse the request, so set this to your deployed docs origin.
DOCS_ORIGIN=https://your-docs-site.vercel.app

# Canonical public HTTPS origins only: no trailing path, query, credentials, or fragment.
# GPU_WORKER_URL is the Cloudflare Tunnel hostname in front of the GPU worker.
GPU_WORKER_URL=https://gpu-worker.example.com
GATEWAY_ORIGIN=https://your-gremlin-gateway.vercel.app
GPU_WORKER_OIDC_AUDIENCE=gremlin-gpu-worker-production

# At least 32 random characters each. Never copy these to the GPU host or the browser.
JOB_CALLBACK_SIGNING_SECRET=
SCULPTOR_ASSET_SIGNING_SECRET=

# Required before public GPU jobs are enabled. The docs build receives only the site key;
# this secret and hostname remain in Vercel environment variables.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=docs.example.com

# Local-only escape hatch for `vercel dev`; never set this in a deployed environment.
# ALLOW_LOCAL_UNPROTECTED_JOBS=true
