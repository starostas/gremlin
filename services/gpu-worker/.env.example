# The service listens only on loopback. Tailscale Funnel terminates HTTPS and
# dials out, so the GPU host needs no inbound port and never publishes its
# address.
PORT=8080
GREMLIN_REPOSITORY=/opt/gremlin
GPU_WORKER_STATE_DIR=/var/lib/gremlin-gpu-worker
MAX_JOB_SECONDS=240

# Exact values from the Vercel gateway project. The OIDC subject must name the
# production team/project/environment claim; do not permit preview or
# development subjects.
GPU_WORKER_OIDC_AUDIENCE=gremlin-gpu-worker-production
VERCEL_OIDC_ISSUER=https://oidc.vercel.com/your-team-slug
VERCEL_OIDC_SUBJECT=owner:your-team-slug:project:gremlin-gpu-gateway:environment:production

# Exact canonical origin of the Vercel project serving the site and job routes.
# The worker only posts back to this origin and never follows redirects.
GATEWAY_ORIGIN=https://your-project.vercel.app

# Orbit Forge compiles the winning program and times it against a reference
# solver. Clang 18 must be present or that evidence is reported as unavailable.
# ORBIT_FORGE_CLANG=/usr/bin/clang-18
