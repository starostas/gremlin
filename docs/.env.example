# Optional canonical URL for production deployments.
SITE_URL=https://your-project.vercel.app

# Public URL for the separate, rate-limited GPU job gateway. Leave unset for replay-only builds.
PUBLIC_EXPERIMENT_API_URL=https://your-gremlin-gateway.vercel.app

# Public Turnstile site key paired with the gateway's server-only TURNSTILE_SECRET_KEY.
# Leave both live-run variables unset for a replay-only deployment.
PUBLIC_EXPERIMENT_TURNSTILE_SITE_KEY=
