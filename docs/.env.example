# Optional canonical URL for production deployments.
SITE_URL=https://your-project.vercel.app

# Set to "true" to show the Run button. The site and its job routes deploy
# together, so there is no API URL to configure. Leave unset for a replay-only
# build: the recorded runs still play.
PUBLIC_EXPERIMENT_LIVE_RUNS=

# Public Turnstile site key, paired with the server-only TURNSTILE_SECRET_KEY.
# Leave unset to run without a human check; the server then requires
# ALLOW_UNVERIFIED_JOBS=true before it will accept a job.
PUBLIC_EXPERIMENT_TURNSTILE_SITE_KEY=

# --- Server-only. Never prefixed PUBLIC_, so the static build cannot read them. ---

# Canonical HTTPS origins only: no trailing path, query, credentials, or fragment.
GPU_WORKER_URL=https://gremlin-gpu.your-tailnet.ts.net
GATEWAY_ORIGIN=https://your-project.vercel.app
GPU_WORKER_OIDC_AUDIENCE=gremlin-gpu-worker-production

# At least 32 random characters each. Never copy these to the GPU host.
JOB_CALLBACK_SIGNING_SECRET=
SCULPTOR_ASSET_SIGNING_SECRET=

QUEUE_REGION=iad1
MAX_PENDING_JOBS=6

# Human verification. With a Turnstile secret set, every job and image upload
# must carry a fresh proof. Without one, the routes stay closed unless you
# explicitly accept unverified jobs, in which case the only limits on GPU use
# are the pending-job cap and the worker running one job at a time.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# ALLOW_UNVERIFIED_JOBS=true
